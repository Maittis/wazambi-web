# Database
# Set this to a PostgreSQL connection string (e.g. Supabase) to switch the app
# from the local data/db.json file store to Postgres. When unset, the file
# store is used (for local development).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wazambi
# TLS is auto-enabled for supabase.co / neon.tech hosts. Override explicitly if needed:
# DATABASE_SSL=true

# Email
# EMAIL_PROVIDER defaults to "log" (writes delivery info to the db).
# Set to "resend" and add a key to send real emails.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_key_here

# Default password used when creating staff members via the CRM.
# STAFF_DEFAULT_PASSWORD=wazambi123